# --- Application ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Comma-separated; default in Settings is ["*"] for the hackday demo.
CORS_ORIGINS=*

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nyaya:nyaya@localhost:5432/nyayaos
POSTGRES_USER=nyaya
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nyayaos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT / Auth ---
JWT_SECRET_KEY=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM / Gemma 4 (Google GenAI / Gemini API) ---
# Providers: gemini | ollama | vllm
LLM_PROVIDER=gemini
# Default (faster): gemma-4-26b-a4b-it  |  Fallback: gemma-4-31b-it
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it
GEMMA_FALLBACK_MODEL=gemma-4-31b-it
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001
EMBEDDING_MODEL=nomic-embed-text
# Insert your key locally in .env (gitignored). Never commit a real key.
GOOGLE_API_KEY=<your-key>

# --- Vector DB / RAG ---
VECTOR_DB=chroma

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nyayaos

# --- External APIs ---
GOOGLE_MAPS_API_KEY=

# --- Uploads / OCR ---
MAX_UPLOAD_SIZE=20971520
UPLOAD_DIRECTORY=./uploads
OCR_PROVIDER=tesseract

# --- Multilingual ---
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,bn,ta,te,mr,gu,pa,kn,ml,ur
